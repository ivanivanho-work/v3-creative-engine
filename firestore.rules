rules_version = '2';

// Phase −1 lockdown: gate every read/write behind Firebase Auth allowlist.
// allowlist = ivanho.wz@gmail.com OR @google.com.
// Triggers (admin SDK) bypass rules — unaffected.

service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'ivanho.wz@gmail.com'
            || request.auth.token.email.matches('.*@google[.]com$'));
    }

    // ========================================================================
    // CREATIVE GENERATOR & TEMPLATE STAMPER
    // ========================================================================

    match /jobs/{jobId} {
      allow read: if authed();
      allow create: if authed();
      // update/delete only via admin SDK (Cloud Functions)
      allow update, delete: if false;
    }

    match /gallery/{galleryId} {
      allow read: if authed();
      allow create: if authed();
      allow delete: if authed();
    }

    match /template_stamper_transfers/{transferId} {
      allow read: if authed();
      allow create: if authed();
      allow update: if authed();
      allow delete: if authed();
    }

    match /reference_characters/{characterId} {
      allow read: if authed();
      allow create, delete: if authed();
      allow update: if false;
    }

    // ========================================================================
    // AGENT COLLECTIVE
    // ========================================================================

    match /agent_markets/{marketId} {
      allow read: if authed();
      allow write: if authed();
    }

    match /chat_archives/{archiveId} {
      allow read: if authed();
      allow create: if authed();
      allow delete: if authed();
    }

    match /prompt_transfers/{transferId} {
      allow read: if authed();
      allow create: if authed();
    }

    match /chat_archives_v2/{archiveId} {
      allow read: if authed();
      allow create: if authed();
      allow delete: if authed();
    }

    match /prompt_transfers_v2/{transferId} {
      allow read: if authed();
      allow create: if authed();
    }

    // ========================================================================
    // SHORTS BRAIN
    // ========================================================================

    match /campaigns/{campaignId} {
      allow read: if authed();
      allow write: if authed();
    }

    match /analysis_results/{resultId} {
      allow read: if authed();
      allow write: if authed();
    }

    match /shorts_brain_snapshots/{snapshotId} {
      allow read: if authed();
      allow write: if authed();
    }

    // Auto-restore store: the analyzed dataset (shortsbrain_data/latest +
    // chunk_* docs) the app reloads on open so work survives exit/re-entry.
    match /shortsbrain_data/{docId} {
      allow read: if authed();
      allow write: if authed();
    }

    match /artifacts/{appId}/public/data/{collection}/{document=**} {
      allow read: if authed();
      allow write: if authed();
    }

    // ========================================================================
    // SHORTS INTEL HUB
    // ========================================================================

    match /weekly_topics/{topicId} {
      allow read: if authed();
      allow write: if false;  // Cloud Functions only
    }

    match /topic_embeddings/{embeddingId} {
      allow read: if authed();
      allow write: if false;  // Cloud Functions only
    }

    match /shorts_intel_hub/{docId} {
      allow read: if authed();
      allow write: if authed();
    }

    match /shorts_intel_hub_archive/{archiveId} {
      allow read: if authed();
      allow write: if authed();
    }

    // ========================================================================
    // ADMIN DASHBOARD — usage events
    // ========================================================================

    match /usage_events/{eventId} {
      allow read: if authed();
      allow create: if authed();
      // immutable — backend writes only, no updates or deletes from clients
      allow update, delete: if false;
    }

    // ========================================================================
    // QA CHECKLIST — shared team checklist state
    // ========================================================================

    match /qa_checklist/{docId} {
      allow read: if authed();
      allow write: if authed();
    }

    // ========================================================================
    // DEFAULT — deny everything else
    // ========================================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
