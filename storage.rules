rules_version = '2';

// Phase −1 lockdown: gate every read/write behind Firebase Auth allowlist.
// allowlist = ivanho.wz@gmail.com OR @google.com.

service firebase.storage {
  match /b/{bucket}/o {

    function authed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (request.auth.token.email == 'ivanho.wz@gmail.com'
            || request.auth.token.email.matches('.*@google[.]com$'));
    }

    // Default read rule — only allowlisted users.
    match /{allPaths=**} {
      allow read: if authed();
    }

    // ========================================================================
    // CREATIVE GENERATOR & TEMPLATE STAMPER
    // ========================================================================

    match /uploads/{country}/{fileName} {
      allow write: if authed()
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /renders/{fileName} {
      allow write: if false;  // Cloud Functions only
    }

    // ========================================================================
    // AGENT COLLECTIVE
    // ========================================================================

    match /knowledge/{market}/{fileName} {
      allow write: if authed()
                   && request.resource.size < 50 * 1024 * 1024
                   && request.resource.contentType.matches('application/pdf|application/vnd.openxmlformats-officedocument.*');
    }

    // ========================================================================
    // SHORTS INTEL HUB
    // ========================================================================

    match /shorts-intel-hub/{fileName} {
      allow write: if false;  // Cloud Functions only
    }

    match /shorts-intel-hub/uploads/{uploadId}/{fileName} {
      allow write: if authed()
                   && request.resource.size < 25 * 1024 * 1024
                   && request.resource.contentType.matches('text/csv|application/vnd.ms-excel|application/octet-stream|text/plain');
    }

    match /shorts-intel-hub/results/{fileName} {
      allow write: if authed()
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('application/json|text/plain');
    }

    // ========================================================================
    // SHORTS BRAIN
    // ========================================================================

    match /shorts-brain/{allPaths=**} {
      allow write: if authed()
                   && request.resource.size < 20 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*|application/json|text/csv');
    }

    // ========================================================================
    // REMOTION TEMPLATES
    // ========================================================================

    match /remotion-bundle/{allPaths=**} {
      allow write: if false;  // Cloud Functions only
    }

    // ========================================================================
    // PUBLIC EXAMPLES (now also auth-gated for read)
    // ========================================================================

    match /examples/{fileName} {
      allow write: if false;  // Cloud Functions only
    }

    // ========================================================================
    // DEFAULT — deny writes everywhere else
    // ========================================================================

    match /{allPaths=**} {
      allow write: if false;
    }
  }
}
